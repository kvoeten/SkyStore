POSTGRES_DB=skystore
POSTGRES_USER=skystore
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DATABASE_URL=postgres://skystore:replace-with-a-strong-random-password@postgres:5432/skystore

AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DISCORD_ID=replace-with-discord-client-id
AUTH_DISCORD_SECRET=replace-with-discord-client-secret
SKYSTORE_ADMIN_DISCORD_ID=replace-with-numeric-discord-user-id

SKYSTORE_PUBLIC_DELAY_DAYS=7
TRUSTED_PROXY_COUNT=1
SKYSTORE_WEB_PORT=3000
